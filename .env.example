# Server
PORT=8008
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/billing

# Auth — use a cryptographically random string (≥32 chars) in production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS — frontend origin(s)
CLIENT_URL=http://localhost:3000
